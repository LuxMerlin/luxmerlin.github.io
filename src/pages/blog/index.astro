---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import BlogCard from '../../components/BlogCard.astro';

const allPosts = await getCollection('blog');
const sortedPosts = allPosts.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
---

<Layout title="Blog - Senior Software Engineer">
  <main class="blog-index">
    <header class="page-header animate-fade-in">
      <h1 class="title">Writings & <span class="text-gradient">Thoughts</span></h1>
      <p class="subtitle text-muted">Articles on software architecture, engineering management, and distributed systems.</p>
    </header>

    <div class="grid animate-fade-in" style="animation-delay: 0.2s;">
      {sortedPosts.map((post) => (
        <BlogCard 
          title={post.data.title}
          description={post.data.description || "Read more about this topic in the full article."}
          date={post.data.publishDate}
          url={`/blog/${post.id}`}
        />
      ))}
    </div>
  </main>
</Layout>

<style>
  .blog-index {
    padding-top: var(--space-lg);
  }

  .page-header {
    margin-bottom: var(--space-xl);
    text-align: center;
  }

  .title {
    font-size: clamp(2.5rem, 4vw, 3.5rem);
    margin-bottom: var(--space-md);
  }

  .subtitle {
    font-size: 1.25rem;
    max-width: 600px;
    margin: 0 auto;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: var(--space-lg);
  }
</style>
