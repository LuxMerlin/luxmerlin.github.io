---
interface Props {
  title: string;
  description: string;
  date: Date;
  url: string;
}

const { title, description, date, url } = Astro.props;

const formattedDate = date.toLocaleDateString('en-GB', {
  year: 'numeric',
  month: 'short',
  day: 'numeric'
});
---

<a href={url} class="card-link">
  <article class="interactive-card glass-panel blog-card">
    <div class="card-content">
      <time class="text-gradient date">{formattedDate}</time>
      <h3>{title}</h3>
      <p class="text-muted">{description}</p>
      
      <div class="read-more">
        Read Article <span class="arrow">&rarr;</span>
      </div>
    </div>
  </article>
</a>

<style>
  .card-link {
    display: block;
    text-decoration: none;
    color: inherit;
  }
  
  .card-link:hover {
    color: inherit;
  }

  .blog-card {
    height: 100%;
  }

  .card-content {
    padding: var(--space-lg);
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .date {
    font-size: 0.875rem;
    font-weight: 600;
    margin-bottom: var(--space-sm);
    display: inline-block;
  }

  h3 {
    margin-bottom: var(--space-sm);
    font-size: 1.25rem;
    transition: color 0.3s ease;
  }
  
  .interactive-card:hover h3 {
    color: var(--accent-secondary);
  }

  p {
    flex-grow: 1;
    margin-bottom: var(--space-md);
  }
  
  .read-more {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text-main);
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: auto;
    transition: color 0.3s ease;
  }
  
  .interactive-card:hover .read-more {
    color: var(--accent-secondary);
  }
  
  .arrow {
    transition: transform 0.3s ease;
  }
  
  .interactive-card:hover .arrow {
    transform: translateX(4px);
  }
</style>
